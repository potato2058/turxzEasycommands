# Arguments passed to `turzx`. Edit this, then:
#   systemctl --user daemon-reload
#   systemctl --user restart turzx.service
#
# Examples:
#   TURZX_ARGS=show /home/gabe/Pictures/photo.jpg --fit cover
#   TURZX_ARGS=show /home/gabe/Pictures/anim.gif --loop --fit cover
#   TURZX_ARGS=show /home/gabe/Pictures/clip.mp4 --loop --fit contain
#   TURZX_ARGS=mirror --fps 10 --fit cover
#   TURZX_ARGS=test
#
# Paths with spaces must be quoted:
#   TURZX_ARGS=show "/home/gabe/Pictures/my file.png" --fit cover

TURZX_ARGS=show /home/gabe/Pictures/rorschach.png --fit cover
