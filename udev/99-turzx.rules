# TURZX / Turing USB smart screens (vendor-specific bulk protocol).
# MODE 0666 is required: TAG+="uaccess" often does not attach an ACL on
# raw usb_device nodes, and MODE 0660 + group root leaves the node
# inaccessible to the logged-in user.
SUBSYSTEM=="usb", ATTR{idVendor}=="1cbe", MODE="0666", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}="turzx.service"
